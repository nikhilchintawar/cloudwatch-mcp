{
  "name": "cloudwatch-mcp",
  "version": "1.0.0",
  "description": "MCP server for searching and analyzing AWS CloudWatch logs",
  "type": "module",
  "main": "./build/index.js",
  "bin": {
    "cloudwatch-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "dev": "tsc --watch",
    "start": "node build/index.js"
  },
  "files": [
    "build"
  ],
  "keywords": [
    "mcp",
    "cloudwatch",
    "aws",
    "logs",
    "model-context-protocol",
    "claude",
    "anthropic"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikhilchintawar/cloudwatch-mcp.git"
  },
  "homepage": "https://github.com/nikhilchintawar/cloudwatch-mcp#readme",
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.700.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
